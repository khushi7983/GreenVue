# Environment Variables for GreenVue
# Copy this file to .env and replace with your actual API keys

# API Keys (ROTATE THESE IF EXPOSED)
NEWS_API_KEY=your_news_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Server Configuration
PORT=5000

# MongoDB Configuration
MONGO_URI=your_mongodb_connection_string_here

# JWT Configuration  
JWT_SECRET=your_jwt_secret_here

# Razorpay Configuration (Test Keys)
REACT_APP_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# AI Configuration - Get free API key from https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

# API Configuration
REACT_APP_API_URL=http://localhost:5000

# AI Configuration
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here