# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/greenvue

# Alternative: MongoDB Atlas (Cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/greenvue

# Server Configuration
PORT=5002
NODE_ENV=development

# Optional: JWT Secret (if you add authentication later)
JWT_SECRET=your-super-secret-jwt-key-here

# Optional: Email Configuration (for contact forms)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password