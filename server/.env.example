# Server Environment Variables Template
# Copy this file to .env and replace with your actual credentials
# NEVER commit the .env file to version control!

# Database Configuration (ROTATE IF COMPROMISED)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name
PORT=5000
NODE_ENV=development

# JWT Configuration (GENERATE NEW SECRET)
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# Email Configuration (CHANGE PASSWORDS IF EXPOSED)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# News API Configuration
NEWS_API_KEY=your_news_api_key_here

# Razorpay Configuration (REGENERATE IF COMPROMISED)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here